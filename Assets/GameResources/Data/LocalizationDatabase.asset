    ja: "\u6368\u3066\u672D\u306E\u5C71\u304B\u3089\u30AB\u30FC\u30C91\u679A\u3092\u9078\u3093\u3067\u624B\u672D\u306B\u52A0\u3048\u308B\u3002"
